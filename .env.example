# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required — no local DB fallback)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── User Auth ───────────────────────────────────────────────────────────────
# Secret for signing user JWT tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# Admin panel login credentials
ADMIN_EMAIL=admin@xendrx.com
ADMIN_PASSWORD=change-me-strong-password

# Secret for signing admin JWT tokens — must be different from JWT_SECRET
ADMIN_JWT_SECRET=change-me-to-another-long-random-secret

# ─── API Server ──────────────────────────────────────────────────────────────
# Port the Express API server listens on (proxied at /api by Vite)
PORT=8080

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── App URL ─────────────────────────────────────────────────────────────────
# Public URL of the app — used by the Telegram bot for Mini App button links
# On Replit dev: https://<your-replit-dev-domain>.replit.dev
# In production: https://yourdomain.com
APP_URL=https://your-replit-domain.replit.dev

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram — /newbot then copy the token
TELEGRAM_BOT_TOKEN=8844310514:AAHhMCwELNI8hBRUD0gvOudVscTyGhduvpY

# Username of your bot (without @), shown in invite links
TELEGRAM_BOT_USERNAME=@xendrx_bot

# ─── PWA Push Notifications (VAPID) ──────────────────────────────────────────
# Generate a key pair with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
#
# IMPORTANT: VAPID_PUBLIC_KEY and VITE_VAPID_PUBLIC_KEY must be identical.
#            Never rotate keys without re-subscribing all push subscribers.
VAPID_PUBLIC_KEY=BHvf3SWnpYWU6mPOEAyPGCKS9nsrQ30gR8e67KBgZFb5lXlMUHR5pUjR7QWpuCW2DrunKEB10V6xxRxtlesvwj0
VAPID_PRIVATE_KEY=T67uS7abEqMOhN55W0C7lBTw2GMlP_HISW1K6GP6tXg
VAPID_EMAIL=support@xendrx.com

# Same as VAPID_PUBLIC_KEY — Vite strips non-VITE_ vars from the browser bundle
VITE_VAPID_PUBLIC_KEY=BHvf3SWnpYWU6mPOEAyPGCKS9nsrQ30gR8e67KBgZFb5lXlMUHR5pUjR7QWpuCW2DrunKEB10V6xxRxtlesvwj0

# ─── Cloudflare Turnstile (Bot Protection) ───────────────────────────────────
# Get both keys from: https://dash.cloudflare.com → Turnstile → your widget
#
# VITE_TURNSTILE_SITE_KEY  — public key, baked into the frontend bundle at build time
# TURNSTILE_SECRET_KEY     — private key, verified server-side (never expose to browser)
#
# NOTE: VITE_TURNSTILE_SITE_KEY must be set BEFORE running "vite build" on the VPS.
#       On Replit dev domains the widget uses Cloudflare's test key automatically;
#       on your real domain (xendrx.com) these keys are used.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADfuSYe1Ks9-MMzT
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-from-cloudflare-dashboard

# ─── Hot Wallet / Deposit Address Derivation ─────────────────────────────────
# Private key of the BSC hot wallet — used for THREE purposes:
#   1. Sign approved USDT withdrawals to users
#   2. Derive unique per-user BEP20 deposit addresses (BIP-44 HD path m/44'/60'/0'/0/<userId>)
#   3. Top up BNB gas on user deposit addresses before sweeping USDT back
#
# Generate a secure key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT: Keep this secret. Anyone with this key can access the hot wallet
#            and derive all user deposit keys. Never commit it to version control.
BSC_HOT_WALLET_PRIVATE_KEY=your-64-hex-char-bsc-private-key

# Public address of the BSC hot wallet — USDT is swept here after each deposit.
# Must match the address derived from BSC_HOT_WALLET_PRIVATE_KEY.
# If omitted, defaults to the hardcoded fallback address in the code.
BSC_HOT_WALLET_ADDRESS=0x24c3AaC7A62a37333885Bc9a8A82ca4fDe7321B3
