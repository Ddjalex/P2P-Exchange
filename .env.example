# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (also accepted as DATABASE_URL)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Alternatively:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── User Auth ───────────────────────────────────────────────────────────────
# Secret for signing user JWT tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# Admin panel login credentials
ADMIN_EMAIL=admin@ethiop2p.com
ADMIN_PASSWORD=change-me-strong-password

# Secret for signing admin JWT tokens — must be different from JWT_SECRET
ADMIN_JWT_SECRET=change-me-to-another-long-random-secret

# ─── API Server ──────────────────────────────────────────────────────────────
# Port the Express API server listens on (proxied at /api by Vite)
PORT=8080

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Port for the Vite dev server (must be 5000 for Replit webview)
# PORT=5000
# Base URL path for the frontend (always / unless using a sub-path)
# BASE_PATH=/

# ─── Third-party Integrations (optional — configured via Admin > Settings) ───
# These are stored in the database system_settings table and not required as
# environment variables. Configure them from the Admin dashboard instead.
#
# FastSMS API key  (for SMS OTP)
# FASTSMS_API_KEY=your-fastsms-api-key
#
# Brevo (Sendinblue) API key (for email OTP)
# BREVO_API_KEY=your-brevo-api-key
# BREVO_SENDER_EMAIL=noreply@ethiop2p.com
# BREVO_SENDER_NAME=EthioP2P
