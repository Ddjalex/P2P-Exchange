# ─── Database ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (required — no local DB fallback)
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# ─── User Auth ───────────────────────────────────────────────────────────────
# Secret for signing user JWT tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ─── Admin Auth ──────────────────────────────────────────────────────────────
# Admin panel login credentials
ADMIN_EMAIL=admin@xendrx.com
ADMIN_PASSWORD=change-me-strong-password

# Secret for signing admin JWT tokens — must be different from JWT_SECRET
ADMIN_JWT_SECRET=change-me-to-another-long-random-secret

# ─── API Server ──────────────────────────────────────────────────────────────
# Port the Express API server listens on (proxied at /api by Vite)
PORT=8080

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─── App URL ─────────────────────────────────────────────────────────────────
# Public URL of the app — used by the Telegram bot for Mini App button links
# On Replit dev: https://<your-replit-dev-domain>.replit.dev
# In production: https://yourdomain.com
APP_URL=https://your-replit-domain.replit.dev

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram — /newbot then copy the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxYZ

# Username of your bot (without @), shown in invite links
TELEGRAM_BOT_USERNAME=YourBotUsername

# ─── PWA Push Notifications (VAPID) ──────────────────────────────────────────
# Generate a key pair with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
#
# IMPORTANT: VAPID_PUBLIC_KEY and VITE_VAPID_PUBLIC_KEY must be identical.
#            Never rotate keys without re-subscribing all push subscribers.
VAPID_PUBLIC_KEY=BHvf3SWnpYWU6mPOEAyPGCKS9nsrQ30gR8e67KBgZFb5lXlMUHR5pUjR7QWpuCW2DrunKEB10V6xxRxtlesvwj0
VAPID_PRIVATE_KEY=T67uS7abEqMOhN55W0C7lBTw2GMlP_HISW1K6GP6tXg
VAPID_EMAIL=support@xendrx.com

# Same as VAPID_PUBLIC_KEY — Vite strips non-VITE_ vars from the browser bundle
VITE_VAPID_PUBLIC_KEY=BHvf3SWnpYWU6mPOEAyPGCKS9nsrQ30gR8e67KBgZFb5lXlMUHR5pUjR7QWpuCW2DrunKEB10V6xxRxtlesvwj0
