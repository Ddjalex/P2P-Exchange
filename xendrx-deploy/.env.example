# ═══════════════════════════════════════════════════════════════
#  Xendrx — P2P Crypto Exchange  |  Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values before starting.
#   cp .env.example .env
#   nano .env

# ─── Database ───────────────────────────────────────────────────
# Neon PostgreSQL connection string (required).
# Get it from https://neon.tech → your project → Connection Details.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# ─── Server ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Public URL of your site (used for CORS, links in emails, etc.)
APP_URL=https://yourdomain.com

# ─── JWT Authentication ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING

# Separate secret for the /admin panel
ADMIN_JWT_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_HEX_STRING

# ─── Admin Account ───────────────────────────────────────────────
# Credentials for the built-in admin user (created on first run).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Telegram Bot (optional) ─────────────────────────────────────
# Create a bot at https://t.me/BotFather and paste the token here.
# Leave blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Web Push Notifications (optional) ───────────────────────────
# Generate VAPID keys with:
#   npx web-push generate-vapid-keys
# IMPORTANT: VAPID_PUBLIC_KEY and VITE_VAPID_PUBLIC_KEY must be the same value.
#            Never rotate keys without re-subscribing all push subscribers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# Same as VAPID_PUBLIC_KEY — Vite strips non-VITE_ vars from the browser bundle
VITE_VAPID_PUBLIC_KEY=

# ─── Cloudflare Turnstile (bot protection on login/register) ─────
# Get both keys at: https://dash.cloudflare.com → Turnstile → your widget
#
# VITE_TURNSTILE_SITE_KEY  — public key, baked into the frontend at build time
#                            (must be set BEFORE running the frontend build)
# TURNSTILE_SECRET_KEY     — private key, verified server-side only
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
