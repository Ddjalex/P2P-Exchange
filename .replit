APP_URL = "https://60e7a590-8bd5-4d5b-936c-5a78302f6b5b-00-3i4dxfhxwqhxj.janeway.replit.dev"
VAPID_PUBLIC_KEY = "BDuv1syriVHJkK_ffTGAOZmpnOUDbKR1jDdH9vNbj2e6GK32-1yrZKGEQG_YUAt7EwDRkooXvxdn1OxER-n_sVc"
VITE_TURNSTILE_SITE_KEY = "0x4AAAAAADfw5Ve1Ks9-MMzT"
